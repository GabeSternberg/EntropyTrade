# Names only. Never commit real values. Copy to .env, which is gitignored.
# Research and execution are separate processes and must not share a Kalshi key.

# demo | production. The application default is demo.
KALSHI_ENV=demo

# Execution process only. A read-scoped key belongs to the market-data process.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# read_only | backtest | paper | shadow | demo | live. Default is read_only.
ENTROPYTRADE_TRADING_MODE=read_only

# Must be exactly "true", in the execution process, before live mode is accepted.
ENTROPYTRADE_LIVE_TRADING_ENABLED=false

# Which file under configs/ is selected. Default is configs/dev/config.yaml.
ENTROPYTRADE_CONFIG=configs/dev/config.yaml

# Research process only. Never present in the execution process environment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
