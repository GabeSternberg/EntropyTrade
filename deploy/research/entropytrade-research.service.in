[Unit]
Description=EntropyTrade private research workbench (research checkout only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@
ExecStart=@PYTHON@ -m entropytrade.operations.research_server serve --config @CONFIG@
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
UMask=0077
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=330
SendSIGKILL=yes
NoNewPrivileges=yes
PrivateUsers=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WORKSPACE@ @BACKUPS@ @RECOVERY@
InaccessiblePaths=@COLLECTOR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
