# Retain receipts/logs/reports, not installed environments or package/browser caches.
**/installation/
**/uv-cache/
**/npm-cache/

# Generated browser internals and workspace archives stay at their original local paths.
# Inventory them with tools/review_artifacts.py before checkpointing. Reports, receipts,
# downloads and screenshots remain reviewable in Git; a checkout alone lacks these bytes.
**/playwright-artifacts/
**/*.zip
