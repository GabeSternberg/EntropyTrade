+  <link rel="stylesheet" href="/style.css">
+  <script src="/app.js" defer></script>
+</head>
+<body>
+  <header class="topbar"><a class="brand" href="/" aria-label="EntropyTrade home"><span class="mark">E</span>EntropyTrade</a><span class="private">● PRIVATE · LOCALHOST</span></header>
+  <main>
+    <div class="intro"><div><p class="eyebrow">THE RESEARCH DESK</p><h1>From an idea to evidence.</h1><p class="lede">Formulate a hypothesis. Test what the data can support. Keep the full lineage.</p></div><span class="boundary">Research only · execution disabled</span></div>
+    <div class="workspace">
+      <aside>
+        <section class="panel compose" aria-labelledby="compose-title">
+          <p class="eyebrow">01 / NEW EXPERIMENT</p><h2 id="compose-title">What would you like to test?</h2>
+          <form id="research-form">
+            <label for="idea">Research idea</label>
+            <textarea id="idea" name="idea" rows="5" maxlength="6000" required placeholder="Do upward forecast revisions improve weather contract probabilities?">Do upward forecast revisions improve weather contract probabilities?</textarea>
+            <div class="examples"><button type="button" data-example="weather">Weather</button><button type="button" data-example="bitcoin">Bitcoin</button><button type="button" data-example="synthetic">Software demo</button></div>
+            <label for="family">Market family</label><select id="family" name="family"><option value="weather">Weather · daily high temperature</option><option value="bitcoin">Bitcoin · KXBTC contracts</option></select>
+            <label for="mode">Data source</label><select id="mode" name="mode"><option value="recorded">Recorded real weather evidence</option><option value="public">Fetch public sources now</option><option value="synthetic">Synthetic weather demonstration</option></select>
+            <p id="mode-help" class="hint"></p>
+            <label for="reasoning">Hypothesis formulation</label><select id="reasoning" disabled><option>Local templates · no provider credentials</option></select>
+            <p id="reasoning-help" class="hint">Select a forecast, revision, disagreement, bias or Bitcoin/spot signal, or enter exact comparisons joined only by AND: revision_f &gt;= 1.25 and hours_to_close &lt; 8. Optional Test/Research prefix; no other surrounding prose, XOR or unless in comparisons. Arbitrary prose is not fully interpreted. YES / hold to settlement / one contract templates only.</p>
+            <button class="primary" id="submit" type="submit">Start research <span aria-hidden="true">↗</span></button>
+            <p id="form-message" role="status" class="hint"></p>
+          </form>
+        </section>
+        <section class="panel history-panel" aria-labelledby="history-title"><div class="section-heading"><h2 id="history-title">Recent runs</h2><button id="refresh" type="button" class="quiet">Refresh</button></div><div id="history"><p class="hint">Loading saved runs…</p></div></section>
+      </aside>
+      <section class="results" aria-label="Research results">
+        <div id="connection" role="status"></div>
+        <div id="run-header"></div>
+        <div id="progress" aria-live="polite"></div>
