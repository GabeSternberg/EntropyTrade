+++ b/backend/src/entropytrade/agents/templates.py
@@ -0,0 +1,268 @@
+"""Bounded local formulation, not language-model reasoning or generated executable code.
+
+Recognize documented signal words and literal feature comparisons. Preserve the complete
+idea in research lineage; unsupported requests remain proposals with no executable spec.
+"""
+
+import re
+from decimal import Decimal
+from typing import TYPE_CHECKING
+from uuid import UUID
+
+from entropytrade.agents.outputs import (
+    CandidateBatch,
+    CandidateVerdict,
+    EvidenceNote,
+    HypothesisBatch,
+    ResearchCandidate,
+    ResearchCritique,
+    ResearchHypothesis,
+)
+from entropytrade.domain.enums import ActorKind, StrategyFamily, TimeInForce
+from entropytrade.domain.lifecycle import Actor
+from entropytrade.domain.strategy import (
+    ComparisonOp,
+    ExecutionPreferences,
+    FeatureRequirement,
+    MarketUniverse,
+    ModelKind,
+    PositionSizing,
+    Predicate,
+    RuleSet,
+    SizingMethod,
+    StrategySpec,
+)
+from entropytrade.domain.time import utc_now
+
+if TYPE_CHECKING:
+    from entropytrade.agents.evidence import ResearchEvidence
+
+ALIASES = (
+    (r"\brevision|\brevis", "revision_f"),
+    (r"\bdisagreement|\bdispersion", "model_disagreement_f"),
+    (r"\bbias", "station_bias_f"),
+    (r"\bbitcoin|\bbtc|\bspot", "spot_minus_floor_usd"),
+    (r"\bforecast|\btemperature|\bweather", "forecast_high_f"),
+)
+# Consume the entire non-whitespace token before validating the bounded decimal grammar.
+# A prefix match could silently change 1.2345678, 1.2e3 or 1,000 into another threshold.
+COMPARISON = re.compile(r"\b([a-z][a-z0-9_]*)\s*(>=|<=|>|<|==)\s*(\S+)")
+DECIMAL_TOKEN = re.compile(r"-?[0-9]+(?:\.[0-9]{1,6})?")
+OPS = {
+    ">": ComparisonOp.GT,
+    ">=": ComparisonOp.GE,
+    "<": ComparisonOp.LT,
+    "<=": ComparisonOp.LE,
+    "==": ComparisonOp.EQ,
+}
+CONJUNCTION_GRAMMAR = (
+    "Use a complete conjunction: [Test|Research] feature OP decimal "
+    "[and feature OP decimal ...]; other connectors, grouping and surrounding prose "
+    "are unsupported"
+)
+
+
+def parse_conjunction(text: str) -> tuple[Predicate, ...]:
+    """Consume the entire expression, never infer AND from extracted comparisons.
+
+    Only the optional documented introductory verb and whitespace-delimited ``and``
+    are accepted outside a comparison. Numeric tokens are validated whole before any
+    Decimal is constructed, including when a token contains punctuation or an operator.
+    """
+    expression = re.sub(r"^(?:test|research)\s+", "", text.strip().casefold(), count=1)
+    predicates = []
+    position = 0
+    while True:
+        match = COMPARISON.match(expression, position)
+        if match is None:
+            raise ValueError(CONJUNCTION_GRAMMAR)
+        if DECIMAL_TOKEN.fullmatch(match[3]) is None:
+            raise ValueError(
+                "Use complete plain decimal tokens with at most six fractional digits; "
+                "scientific notation, separators and suffixes are unsupported"
+            )
+        predicates.append(
+            Predicate(feature=match[1], op=OPS[match[2]], threshold=Decimal(match[3]))
+        )
+        position = match.end()
+        if position == len(expression):
+            return tuple(predicates)
+        connector = re.compile(r"\s+and\s+").match(expression, position)
+        if connector is None:
+            raise ValueError(CONJUNCTION_GRAMMAR)
+        position = connector.end()
+
+
+def formulate_templates(
+    prompt: str,
+    evidence: "ResearchEvidence",
+    run_id: str,
+) -> tuple[EvidenceNote, HypothesisBatch, CandidateBatch, ResearchCritique]:
+    """Two predeclared model comparisons over the requested signal.
+
+    Comparisons are conjunctions, with exact decimals; no eval, guessed thresholds or
+    arbitrary tool selection. Bare prose selects a signal for modeling, not an entry filter.
+    """
+    citations = tuple(c["evidence_id"] for c in evidence.calls[:3])
+    text = prompt.casefold()
+    matches = list(COMPARISON.finditer(text))
+    names = tuple(dict.fromkeys(m[1] for m in matches))
+    if not names:
+        names = tuple(
+            n for n in evidence.registered_names if re.search(rf"\b{re.escape(n)}\b", text)
+        )
+    if not names:
+        names = next(
+            ((name,) for pattern, name in ALIASES if re.search(pattern, text)),
+            ("unrecognized_signal",),
+        )
+    series = tuple(sorted({m["series"] for m in evidence.markets}))
+    # A named actual series scopes the template; otherwise all permitted series are explicit.
+    selected = tuple(s for s in series if s.casefold() in text) or series
+    family = selected[0] if selected else "UNAVAILABLE"
+    sources = tuple(evidence.coverage["configured_source_kinds"])
+    if evidence.coverage["data_kind"] != "synthetic" and "revision_f" in evidence.registered_names:
+        sources = ("kalshi", "open-meteo")
+    unsupported = []
+    predicates: tuple[Predicate, ...] = ()
+    if re.search(r"[<>=!]", text):
+        try:
+            predicates = parse_conjunction(text)
+        except ValueError as exc:
+            unsupported.append(str(exc))
+    if len(names) > 10:
+        unsupported.append("Local formulation supports at most ten distinct requested signals")
+        names = names[:10]
+    if re.search(
+        r"\b(kelly|hedg\w*|momentum|arbitrage|short|sell|buy no|resting|limit order)\b", text
+    ):
+        unsupported.append("Requested semantics exceed local YES/hold-to-settlement templates")
+    if re.search(r"\b(or|xor|unless|not|nor|otherwise|except|if|when)\b|[|&^]|!=", text):
+        unsupported.append("Unsupported logic requires a reviewed explicit specification")
+    missing_names = set(names) - set(evidence.registered_names)
+    if missing_names:
+        unsupported.append(
+            "Signal unavailable in this adapter: " + ", ".join(sorted(missing_names))
+        )
+    if not selected:
+        unsupported.append("No actual listed contracts are available in the captured evidence")
+    hypotheses, candidates = [], []
+    for index, variables in enumerate((names, tuple(dict.fromkeys((*names, "hours_to_close"))))):
+        mechanism = (
+            "The requested signal " + ", ".join(names) + " may improve contract probabilities."
+            if index == 0
+            else "A forecast-error baseline may be more stable than regression for this signal."
+        )
+        hypothesis = ResearchHypothesis(
+            hypothesis_id=f"template-h{index}",
+            mechanism=mechanism,
+            market_family=family,
+            window="Frozen decision-time inputs before each actual contract close",
+            variables=variables,
+            direction="Test probability accuracy; association and sign remain unverified",
+            test="Compare event-weighted temporal validation Brier and log loss with baselines.",
+            falsification="Reject without validation improvement and fee-aware depth evidence.",
+            necessary_evidence=(
+                "Point-in-time source vintages and source-matched official outcomes",
+                "Independent date blocks, historical sized books and effective fees",
+            ),
+            evidence_ids=citations,
+        )
+        hypotheses.append(hypothesis)
+        model = "ridge" if index == 0 else "forecast_error"
+        if "forward_only" in evidence.config.model_families:
+            model = "forward_only"
+        spec = None
+        if not unsupported:
+            spec = StrategySpec(
+                strategy_id=f"local-template-{index}",
+                name=f"{family} signal test {index + 1}",
+                version=1,
+                description=mechanism,
+                hypothesis=mechanism,
+                strategy_family=StrategyFamily.INFORMATIONAL,
+                market_universe=MarketUniverse(
+                    series_tickers=selected, description="Actual permitted captured series"
+                ),
+                required_sources=sources,
+                features=tuple(
+                    FeatureRequirement(
+                        name=n,
+                        version=evidence.registered_versions[n],
+                        description="Frozen decision-time covariate",
+                    )
+                    for n in variables
+                ),
+                model_kind=ModelKind.DOMAIN_STATISTICAL,
+                entry_rules=RuleSet(
+                    description="Requested comparisons AND model probability > 0.55",
+                    all_of=(
+                        Predicate(
+                            feature="model_yes_probability",
+                            op=ComparisonOp.GT,
+                            threshold=Decimal("0.55"),
+                        ),
+                        *predicates,
+                    ),
+                ),
+                exit_rules=RuleSet(
+                    description="Hold to settlement using the official contract outcome",
+                    all_of=(
+                        Predicate(feature="settlement", op=ComparisonOp.EQ, threshold=Decimal(1)),
+                    ),
+                ),
+                minimum_edge=Decimal("0.03"),
+                position_sizing=PositionSizing(
+                    method=SizingMethod.FIXED_CONTRACTS,
+                    contracts=Decimal(1),
+                    max_contracts=Decimal(1),
+                ),
+                execution=ExecutionPreferences(time_in_force=TimeInForce.FILL_OR_KILL),
+                assumptions=(
+                    "Local template; unsupported prose is not interpreted as trading rules",
+                    "Model families use their registered feature sets; no feature ablation",
+                ),
+                invalidation_conditions=("Evidence, model or execution gates fail",),
+                generated_by=Actor(kind=ActorKind.AGENT, actor_id="local-template-v1"),
+                generation_run_id=UUID(run_id),
+                created_at=utc_now(),
+            )
+        candidates.append(
+            ResearchCandidate(
+                candidate_id=f"template-c{index}",
+                hypothesis_id=hypothesis.hypothesis_id,
+                spec=spec,
+                missing_capability="; ".join(unsupported),
+                required_features=variables,
+                required_sources=sources or ("kalshi",),
+                model_family=model,
+                evidence_ids=citations,
+            )
+        )
+    note = EvidenceNote(
+        market_understanding="Local templates select signals and literal feature comparisons.",
+        mechanisms=tuple(h.mechanism for h in hypotheses),
+        limitations=(
+            "No language model is used; arbitrary prose is not fully understood.",
+            "Two model comparisons are not causal tests or feature ablations.",
+            *unsupported,
+        ),
+        evidence_ids=citations,
+    )
+    critique = ResearchCritique(
+        verdicts=tuple(
+            CandidateVerdict(
+                candidate_id=c.candidate_id,
+                accept_for_experiment=not unsupported,
+                reason="Local rule checks only; independent evidence and experiment gates apply.",
+                concerns=("No LLM critique or empirical edge follows from local formulation.",),
+            )
+            for c in candidates
+        )
+    )
+    return (
+        note,
+        HypothesisBatch(hypotheses=tuple(hypotheses)),
+        CandidateBatch(candidates=tuple(candidates)),
+        critique,
+    )
diff --git a/backend/src/entropytrade/api/jobs.py b/backend/src/entropytrade/api/jobs.py
new file mode 100644
index 0000000..ef91717
--- /dev/null
+++ b/backend/src/entropytrade/api/jobs.py
@@ -0,0 +1,171 @@
+"""Durable, bounded local jobs. This control plane needs only the standard library."""
+
+import json
+import sqlite3
+from collections.abc import Iterator
+from contextlib import contextmanager
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+from uuid import UUID, uuid4
+
+TERMINAL = frozenset({"completed", "failed", "cancelled", "interrupted"})
+
+
+def timestamp() -> str:
+    return datetime.now(UTC).isoformat()
+
+
+def identifier(value: str) -> str:
+    if str(UUID(value)) != value:
+        raise ValueError("invalid job ID")
+    return value
+
+
+def validate_request(value: object) -> dict[str, str]:
+    if not isinstance(value, dict) or set(value) != {"idea", "family", "mode"}:
+        raise ValueError("provide only idea, family and mode")
+    if any(not isinstance(v, str) for v in value.values()):
+        raise ValueError("request values must be strings")
+    idea, family, mode = value["idea"].strip(), value["family"], value["mode"]
+    if not 1 <= len(idea) <= 6000:
+        raise ValueError("idea must contain 1-6000 characters")
+    if family not in {"weather", "bitcoin"} or mode not in {"recorded", "public", "synthetic"}:
+        raise ValueError("unknown family or data mode")
+    if family == "bitcoin" and mode != "public":
+        raise ValueError("Bitcoin currently supports public forward capture only")
+    return {"idea": idea, "family": family, "mode": mode}
+
+
+class Jobs:
+    def __init__(self, root: Path) -> None:
+        self.root = root
+        root.mkdir(parents=True, exist_ok=True)
+        self.path = root / "jobs.sqlite"
+        with self.connect() as db:
+            db.executescript("""
+                PRAGMA journal_mode=WAL;
+                CREATE TABLE IF NOT EXISTS jobs (
+                    id TEXT PRIMARY KEY, request TEXT NOT NULL, status TEXT NOT NULL,
+                    created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
+                    detail TEXT NOT NULL, result TEXT);
+                CREATE TABLE IF NOT EXISTS events (
+                    sequence INTEGER PRIMARY KEY, job_id TEXT NOT NULL,
+                    at TEXT NOT NULL, stage TEXT NOT NULL, detail TEXT NOT NULL);
+            """)
+
+    @contextmanager
+    def connect(self) -> Iterator[sqlite3.Connection]:
+        db = sqlite3.connect(self.path, timeout=10)
+        db.row_factory = sqlite3.Row
+        try:
+            with db:
+                yield db
+        finally:
+            db.close()
+
+    def create(self, request: object) -> str:
+        clean = validate_request(request)
+        job_id, now = str(uuid4()), timestamp()
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            count = db.execute(
+                "SELECT count(*) FROM jobs WHERE status IN ('queued', 'running')"
+            ).fetchone()[0]
+            if count >= 8:
+                raise ValueError("local queue is full (eight jobs)")
+            db.execute(
+                "INSERT INTO jobs VALUES (?, ?, 'queued', ?, ?, 'Waiting for worker', NULL)",
+                (job_id, json.dumps(clean), now, now),
+            )
+            db.execute(
+                "INSERT INTO events(job_id, at, stage, detail) VALUES (?, ?, 'queued', ?)",
+                (
+                    job_id,
+                    now,
+                    "Request saved; local templates or explicit synthetic mock reasoning",
+                ),
+            )
+        return job_id
+
+    def get(self, job_id: str) -> dict[str, Any] | None:
+        with self.connect() as db:
+            row = db.execute("SELECT * FROM jobs WHERE id=?", (identifier(job_id),)).fetchone()
+            if row is None:
+                return None
+            result = dict(row)
+            result["request"] = json.loads(result["request"])
+            result["result"] = json.loads(result["result"]) if result["result"] else None
+            result["events"] = [
+                dict(e)
+                for e in db.execute(
+                    "SELECT sequence, at, stage, detail FROM events WHERE job_id=? "
+                    "ORDER BY sequence",
+                    (job_id,),
+                )
+            ]
+            return result
+
+    def history(self) -> list[dict[str, Any]]:
+        with self.connect() as db:
+            return [
+                {**dict(r), "request": json.loads(r["request"])}
+                for r in db.execute(
+                    "SELECT id, request, status, created_at, updated_at, detail FROM jobs "
+                    "ORDER BY created_at DESC LIMIT 50"
+                )
+            ]
+
+    def queued(self) -> str | None:
+        with self.connect() as db:
+            row = db.execute(
+                "SELECT id FROM jobs WHERE status='queued' ORDER BY created_at LIMIT 1"
+            ).fetchone()
+            return str(row[0]) if row else None
+
+    def update(
+        self,
+        job_id: str,
+        stage: str,
+        detail: str,
+        *,
+        status: str = "running",
+        result: dict[str, Any] | None = None,
+    ) -> bool:
+        if status not in {"running", *TERMINAL}:
+            raise ValueError("invalid job status")
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            row = db.execute("SELECT status FROM jobs WHERE id=?", (identifier(job_id),)).fetchone()
+            if row is None or row[0] in TERMINAL:
+                return False
+            now = timestamp()
+            db.execute(
+                "UPDATE jobs SET status=?, detail=?, updated_at=?, result=? WHERE id=?",
+                (
+                    status,
+                    detail,
+                    now,
+                    json.dumps(result, allow_nan=False) if result else None,
+                    job_id,
+                ),
+            )
+            db.execute(
+                "INSERT INTO events(job_id, at, stage, detail) VALUES (?, ?, ?, ?)",
+                (job_id, now, stage, detail),
+            )
+            return True
+
+    def recover(self) -> None:
+        with self.connect() as db:
+            ids = [
+                r[0]
+                for r in db.execute("SELECT id FROM jobs WHERE status IN ('queued', 'running')")
+            ]
+        for job_id in ids:
+            self.update(
+                job_id,
+                "interrupted",
+                "Server stopped; submit a new run to retry",
+                status="interrupted",
+            )
diff --git a/backend/src/entropytrade/api/runner.py b/backend/src/entropytrade/api/runner.py
new file mode 100644
index 0000000..f688668
--- /dev/null
+++ b/backend/src/entropytrade/api/runner.py
@@ -0,0 +1,107 @@
+"""One isolated credential-free process at a time, with cancellation and wall-time bounds."""
+
+import os
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+from entropytrade.api.jobs import Jobs
+
+
+def worker_environment(repo: Path, workspace: Path) -> dict[str, str]:
+    # An allowlist, never a copy of the parent's credentials or SDK configuration.
+    return {
+        "PATH": os.defpath,
+        "PYTHONPATH": str(repo / "backend" / "src"),
+        "PYTHONNOUSERSITE": "1",
+        "PYTHONDONTWRITEBYTECODE": "1",
+        "TMPDIR": str(workspace),
+        "MPLCONFIGDIR": str(workspace / "matplotlib"),
+        "MLFLOW_TRACKING_URI": (workspace / "mlflow").as_uri(),
+        "OMP_NUM_THREADS": "1",
+        "OPENBLAS_NUM_THREADS": "1",
+        "TZ": "UTC",
+    }
+
+
+class Runner:
+    def __init__(self, jobs: Jobs, repo: Path, *, timeout: float = 600) -> None:
+        self.jobs, self.repo, self.timeout = jobs, repo, timeout
+        self.stop = threading.Event()
+        self.thread = threading.Thread(target=self.run, name="research-queue", daemon=True)
+
+    def start(self) -> None:
+        self.thread.start()
+
+    def close(self) -> None:
+        self.stop.set()
+        if self.thread.ident is not None:
+            self.thread.join(timeout=5)
+
+    def run(self) -> None:
+        while not self.stop.is_set():
+            job_id = self.jobs.queued()
+            if job_id is None:
+                self.stop.wait(0.25)
+                continue
+            if not self.jobs.update(job_id, "starting", "Starting isolated research worker"):
+                continue
+            try:
+                self.execute(job_id)
+            except OSError:
+                self.jobs.update(job_id, "failed", "Worker could not start", status="failed")
+
+    def execute(self, job_id: str) -> None:
+        command = [
+            sys.executable,
+            "-m",
+            "entropytrade.api.worker",
+            "--workspace",
+            str(self.jobs.root),
+            "--repo",
+            str(self.repo),
+            "--job",
+            job_id,
+        ]
+        with subprocess.Popen(  # noqa: S603 - fixed module and validated UUID, no shell
+            command,
+            cwd=self.repo,
+            env=worker_environment(self.repo, self.jobs.root),
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+        ) as process:
+            started = time.monotonic()
+            while process.poll() is None:
+                job = self.jobs.get(job_id)
+                if self.stop.is_set() or not job or job["status"] == "cancelled":
+                    process.kill()
+                    process.wait()
+                    self.jobs.update(
+                        job_id,
+                        "interrupted",
+                        "Worker stopped with the server",
+                        status="interrupted",
+                    )
+                    return
+                if time.monotonic() - started > self.timeout:
+                    process.kill()
+                    process.wait()
+                    self.jobs.update(
+                        job_id,
+                        "failed",
+                        "Worker exceeded the ten-minute wall-time budget",
+                        status="failed",
+                    )
+                    return
+                self.stop.wait(0.2)
+        job = self.jobs.get(job_id)
+        if job and job["status"] == "running":
+            self.jobs.update(
+                job_id,
+                "failed",
+                "Worker exited without a completed result; check dependencies",
+                status="failed",
+            )
diff --git a/backend/src/entropytrade/api/server.py b/backend/src/entropytrade/api/server.py
new file mode 100644
index 0000000..44cb04b
--- /dev/null
+++ b/backend/src/entropytrade/api/server.py
@@ -0,0 +1,197 @@
+"""Loopback-only HTTP workbench with same-origin writes and a fixed asset allowlist."""
+
+import argparse
+import fcntl
+import json
+import secrets
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from entropytrade.api.jobs import Jobs, identifier
+from entropytrade.api.runner import Runner
+
+ASSETS = {
+    "/": ("index.html", "text/html; charset=utf-8"),
+    "/app.js": ("app.js", "text/javascript; charset=utf-8"),
+    "/style.css": ("style.css", "text/css; charset=utf-8"),
+}
+
+
+def workspace_path(repo: Path, workspace: Path) -> Path:
+    resolved = workspace.resolve()
+    # User input never selects filesystem paths. Even the CLI is confined to the cache tree.
+    cache = (repo.resolve() / "data" / "cache").resolve()
+    if (
+        not cache.is_relative_to(repo.resolve())
+        or not resolved.is_relative_to(cache)
+        or resolved == cache
+    ):
+        raise ValueError("workspace must be a subdirectory of repository data/cache")
+    return resolved
+
+
+class WorkbenchServer(ThreadingHTTPServer):
+    daemon_threads = True
+    block_on_close = True
+
+    def __init__(self, repo: Path, workspace: Path, *, port: int = 43128) -> None:
+        self.repo = repo.resolve()
+        self.jobs = Jobs(workspace_path(self.repo, workspace))
+        self.runner = Runner(self.jobs, self.repo)
+        self.lock = (self.jobs.root / ".writer.lock").open("a")
+        try:
+            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            super().__init__(("127.0.0.1", port), Handler)
+        except BaseException:
+            self.lock.close()
+            raise
+        self.token = secrets.token_urlsafe(32)
+        self.jobs.recover()
+
+    def server_close(self) -> None:
+        self.runner.close()
+        super().server_close()
+        self.lock.close()
+
+
+class Handler(BaseHTTPRequestHandler):
+    server: WorkbenchServer
+    timeout = 5
+
+    def log_message(self, format: str, *args: object) -> None:
+        # Prompts and URLs are private research history, not console access logs.
+        del format, args
+
+    def safe_origin(self) -> bool:
+        host = self.headers.get("Host", "")
+        port = self.server.server_port
+        if host not in {f"127.0.0.1:{port}", f"localhost:{port}"}:
+            return False
+        origin = self.headers.get("Origin")
+        return self.headers.get("Sec-Fetch-Site") != "cross-site" and (
+            origin is None or origin == "http://" + host
+        )
+
+    def send(self, status: int, body: bytes, content_type: str = "application/json") -> None:
+        self.send_response(status)
+        self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.send_header("Cache-Control", "no-store")
+        self.send_header("X-Content-Type-Options", "nosniff")
+        self.send_header("Referrer-Policy", "no-referrer")
+        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
+        self.send_header(
+            "Content-Security-Policy",
+            "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; "
+            "img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
+        )
+        self.end_headers()
+        self.wfile.write(body)
+
+    def document(self, status: int, value: object) -> None:
+        self.send(status, json.dumps(value, allow_nan=False).encode())
+
+    def job_route(self) -> tuple[str, str] | None:
+        parts = urlsplit(self.path).path.strip("/").split("/")
+        if len(parts) not in {3, 4} or parts[:2] != ["api", "jobs"]:
+            return None
+        try:
+            job_id = identifier(parts[2])
+        except ValueError:
+            return None
+        return job_id, parts[3] if len(parts) == 4 else ""
+
+    def do_GET(self) -> None:
+        if not self.safe_origin():
+            self.document(403, {"error": "localhost same-origin access required"})
+            return
+        path = urlsplit(self.path).path
+        if path in ASSETS:
+            name, kind = ASSETS[path]
+            self.send(200, (self.server.repo / "frontend" / "src" / name).read_bytes(), kind)
+        elif path == "/api/catalog":
+            self.document(
+                200,
+                {
+                    "csrf_token": self.server.token,
+                    "reasoning": "local_templates; synthetic mode uses explicit mock proposals",
+                    "families": ["weather", "bitcoin"],
+                    "modes": ["recorded", "public", "synthetic"],
+                    "provider_enabled": False,
+                    "submission_enabled": False,
+                    "limits": {"queued_jobs": 8, "worker_seconds": 600, "synthetic_days": 240},
+                },
+            )
+        elif path == "/api/jobs":
+            self.document(200, self.server.jobs.history())
+        else:
+            route = self.job_route()
+            job = self.server.jobs.get(route[0]) if route else None
+            if job is None or route is None or route[1] not in {"", "report", "review"}:
+                self.document(404, {"error": "not found"})
+            elif route[1] == "report":
+                self.send(
+                    200,
+                    ((job["result"] or {}).get("report", "Run has no report yet.")).encode(),
+                    "text/plain; charset=utf-8",
+                )
+            elif route[1] == "review":
+                self.document(200, job["result"])
+            else:
+                self.document(200, job)
+
+    def do_POST(self) -> None:
+        if not self.safe_origin() or not secrets.compare_digest(
+            self.headers.get("X-EntropyTrade-CSRF", ""), self.server.token
+        ):
+            self.document(403, {"error": "same-origin token required"})
+            return
+        if self.headers.get("Content-Type") != "application/json" or self.headers.get(
+            "Transfer-Encoding"
+        ):
+            self.document(415, {"error": "use application/json without transfer encoding"})
+            return
+        try:
+            size = int(self.headers.get("Content-Length", "0"))
+            if not 0 < size <= 24_000:
+                raise ValueError("request exceeds size budget or is empty")
+            value = json.loads(self.rfile.read(size))
+            if self.path == "/api/jobs":
+                job_id = self.server.jobs.create(value)
+                self.document(202, {"id": job_id})
+                return
+            route = self.job_route()
+            if route and route[1] == "cancel" and value == {}:
+                job = self.server.jobs.get(route[0])
+                if job is not None:
+                    changed = self.server.jobs.update(
+                        route[0], "cancelled", "Cancelled by user", status="cancelled"
+                    )
+                    self.document(200, {"cancelled": changed})
+                    return
+        except (ValueError, UnicodeError) as exc:
+            self.document(400, {"error": str(exc)})
+            return
+        self.document(404, {"error": "not found"})
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="EntropyTrade private localhost workbench")
+    parser.add_argument("--port", type=int, default=43128)
+    parser.add_argument("--workspace", type=Path, default=Path("data/cache/workbench"))
+    args = parser.parse_args()
+    repo = Path(__file__).resolve().parents[4]
+    workspace = args.workspace if args.workspace.is_absolute() else repo / args.workspace
+    server = WorkbenchServer(repo, workspace, port=args.port)
+    server.runner.start()
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/backend/src/entropytrade/api/worker.py b/backend/src/entropytrade/api/worker.py
